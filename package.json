{
  "name": "smart-bed-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js",
    "build:flutter": "vite build --config vite.embed.config.js && node scripts/package-flutter.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "export:fallback": "node scripts/export-fallback-assets.mjs",
    "export:catalog": "node scripts/export-model-catalog.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
