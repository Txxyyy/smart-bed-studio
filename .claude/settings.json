{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run build)",
      "Bash(npm run build:flutter)",
      "Bash(npm run dev)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(flutter analyze)",
      "Bash(flutter test)",
      "Bash(flutter pub get)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run check)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)"
    ],
    "deny": [
      "Edit(dist/**)",
      "Edit(exports/baseline-v12/**)",
      "Edit(flutter/smart_mattress_viewer/INTEGRATION.md)",
      "Edit(flutter/smart_mattress_viewer/MODEL_SDK_API.md)",
      "Edit(flutter/smart_mattress_viewer/assets/manifest.json)",
      "Edit(flutter/smart_mattress_viewer/assets/mattress.html)",
      "Edit(references/**)",
      "Write(dist/**)",
      "Write(exports/baseline-v12/**)",
      "Write(flutter/smart_mattress_viewer/INTEGRATION.md)",
      "Write(flutter/smart_mattress_viewer/MODEL_SDK_API.md)",
      "Write(flutter/smart_mattress_viewer/assets/manifest.json)",
      "Write(flutter/smart_mattress_viewer/assets/mattress.html)",
      "Write(references/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
